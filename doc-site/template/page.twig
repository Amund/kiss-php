{% extends 'base.twig' %}

{% block content %}
<h2>{{ title }}</h2>

{% if sections|length > 1 %}
<ul class="toc">
{% for section in sections %}
  <li><a href="#{{ section.title|slugify }}">{{ section.title }}</a></li>
{% endfor %}
</ul>
{% endif %}

{% for section in sections %}
<section>
    <h3 id="{{ section.title|slugify }}">{{ section.title }}</h3>
    {% if section.content is defined %}
    {{ section.content|markdown|raw }}
    {% endif %}
    {% if section.image is defined %}
    <img src="{{ asset(section.image) }}" alt="" style="max-width:100%;border-radius:8px;margin-top:1.5rem;margin-inline:auto;display:block;">
    {% endif %}
    {% if section.tabs is defined %}
    <div class="tabs">
    {% for tab in section.tabs %}
        <input type="radio" name="tab-{{ loop.parent.loop.index }}"
               id="tab-{{ loop.parent.loop.index }}-{{ loop.index }}"
               {{ loop.first ? 'checked' : '' }}>
        <label for="tab-{{ loop.parent.loop.index }}-{{ loop.index }}">{{ tab.label }}</label>
        <div class="tab-content">
<pre><code class="language-{{ tab.language }}">{{ tab.code|e }}</code></pre>
        </div>
    {% endfor %}
    </div>
    {% endif %}
</section>
{% endfor %}
{% endblock %}
