{
  "name": "amund/kiss-php",
  "version": "1.0.0-dev",
  "type": "library",
  "license": "MIT",
  "description": "Kiss (Keep It Simply Static) is a php static site generator.",
  "authors": [
    {
      "name": "Dimitri Avenel",
      "email": "mailamund@gmail.com"
    }
  ],
  "require": {
    "twig/twig": "^3.5",
    "symfony/yaml": "^6.2",
    "symfony/filesystem": "^6.2",
    "symfony/var-dumper": "^6.2",
    "scssphp/scssphp": "^1.11"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "squizlabs/php_codesniffer": "^3.7",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "mikey179/vfsstream": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "Kiss\\": "src/"
    }
  },
  "scripts": {
    "lint:php": "vendor/bin/phpcs engine || true",
    "fix:php": "vendor/bin/phpcbf engine || true"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "bin": [
    "src/bin/kiss"
  ]
}
