{
	"name": "amund/kiss-php",
	"version": "0.2.1",
	"type": "library",
	"license": "MIT",
	"description": "Kiss (Keep It Simply Static) is a php static site generator.",
	"authors": [
		{
			"name": "Dimitri Avenel",
			"email": "mailamund@gmail.com"
		}
	],
	"require": {
		"twig/twig": "^3",
		"symfony/yaml": "^7",
		"symfony/filesystem": "^7",
		"symfony/var-dumper": "^7",
		"league/commonmark": "^2.8"
	},
	"require-dev": {
		"phpunit/phpunit": "^11",
		"squizlabs/php_codesniffer": "^4",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"mikey179/vfsstream": "^1.6",
		"phpstan/phpstan": "^2.1"
	},
	"autoload": {
		"psr-4": {
			"Kiss\\": "src/"
		}
	},
	"scripts": {
		"lint:php": "vendor/bin/phpcs engine || true",
		"fix:php": "vendor/bin/phpcbf engine || true"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"bin": ["src/bin/kiss"]
}
