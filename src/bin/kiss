#!/usr/bin/env php
<?php

namespace Kiss;

if (!is_file('vendor/autoload.php')) {
    fwrite(STDERR, "\nNo autoload.php found, you must run 'make composer i' first.\n\n");
    exit(1);
}

require_once 'vendor/autoload.php';

$kiss = new Kiss();
$totalTask = $kiss->newTask();
$kiss->config();

try {
    switch (@$argv[1]) {
        case 'init':
            $kiss->config()->init($argv[2] ?? null);
            break;

        case 'test':
            $kiss->warmup();
            break;

        case 'build':
            $kiss
                ->version()
                ->warmup()
                ->build();
            break;

        case 'watch':
            $kiss
                ->version()
                ->warmup()
                ->build();
            $kiss->log->line('Watching...');
            $kiss->log->line('Press Ctrl+C to stop.');
            $watches = $kiss->getWatches();
            $self = $_SERVER['PHP_SELF'] ?? $argv[0];

            if (`which inotifywait 2>/dev/null`) {
                passthru(sprintf(
                    "inotifywait -mrq -e close_write -e moved_to -e moved_from -e delete --format '%%w%%f' %s | while read LINE; do %s watched \$LINE; done",
                    $watches,
                    $self
                ));
            } elseif (`which fswatch 2>/dev/null`) {
                passthru(sprintf(
                    "fswatch -r -0 %s | xargs -0 -n1 -I {} %s watched {}",
                    $watches,
                    $self
                ));
            } else {
                fwrite(STDERR, "\nNo watcher found. Install inotifywait (linux/wsl) or fswatch (mac).\n\n");
                exit(1);
            }
            break;

        case 'watched':
            $arg = $argv[2] ?? null;
            $kiss->warmup()->watched($arg);
            exit(0);

        case 'reset':
            $arg = $argv[2] ?? 'all';
            $kiss
                ->version()
                ->warmup()
                ->reset($arg);
            break;

        case 'copy':
            $arg = $argv[2] ?? null;
            $kiss
                ->version()
                ->warmup()
                ->copy($arg);
            break;

        case 'route':
            $arg = $argv[2] ?? 'all';
            $kiss
                ->version()
                ->warmup()
                ->route($arg);
            break;

        case 'img':
            $kiss
                ->version()
                ->warmup()
                ->img();
            break;

        default:
            $kiss->version()->help();
    }
} catch (KissException $e) {
    $kiss->log->error($e->getMessage());

    if ($e->isUserCodeError()) {
        $prev = $e->getPrevious();
        $relFile = str_replace(getcwd() . '/', '', $prev->getFile());
        $kiss->log->error('  File: {file} line {line}', [
            '{file}' => $relFile,
            '{line}' => $prev->getLine(),
        ]);
    }

    $fix = $e->getFix();
    if ($fix) {
        $kiss->log->info($fix);
    }

    exit(1);
}

$kiss->log->line();
$totalTask->end('total time')->setLog($kiss->log);
