#!/usr/bin/env php
<?php namespace Kiss;

if (!is_file('vendor/autoload.php')) {
    die(
        "\nNo autoload.php found, you must launch 'make composer i' before.\n\n"
    );
}

require_once 'vendor/autoload.php';

$kiss = new Kiss();
$totalTask = $kiss->newTask();
$kiss->config();

try {
    switch (@$argv[1]) {
        case 'test':
            $kiss->warmup();
            break;

        case 'build':
            $kiss
                ->version()
                ->warmup()
                ->build();
            break;

        case 'watch':
            $kiss
                ->version()
                ->warmup()
                ->build();

            $kiss->log
                ->line()
                ->line('Watching...')
                ->line();
            $watches = $kiss->getWatches();
            system(
                <<<SH
inotifywait -mrq -e close_write -e moved_to -e delete --format '%w%f' $watches | while read LINE; do vendor/bin/kiss watched \$LINE; done
SH
            );
            break;

        case 'watched':
            $arg = $argv[2] ?? null;
            $kiss->warmup()->watched($arg);
            break;

        case 'reset':
            $arg = $argv[2] ?? 'all';
            $kiss
                ->version()
                ->warmup()
                ->reset($arg);
            break;

        case 'copy':
            $arg = $argv[2] ?? null;
            $kiss
                ->version()
                ->warmup()
                ->copy($arg);
            break;

        case 'route':
            $arg = $argv[2] ?? 'all';
            $kiss
                ->version()
                ->warmup()
                ->route($arg);
            break;

        case 'img':
            $kiss
                ->version()
                ->warmup()
                ->img();
            break;

        default:
            $kiss->version()->help();
    }
} catch (KissException $e) {
    $kiss->log->error('{message} in {file} line {line}' . "\n" . '{trace}', [
        '{message}' => $e->getMessage(),
        '{file}' => $e->getFile(),
        '{line}' => $e->getLine(),
        '{trace}' => $e->getTraceAsString(),
    ]);
    $kiss->log->line();
    die();
}

$kiss->log->line();
$totalTask->end('total time')->setLog($kiss->log);
